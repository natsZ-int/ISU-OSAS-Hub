APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Gmail SMTP (real email delivery) ──────────────────────────────────────
# Used for OTP verification emails AND automatic student notifications
# (scholarship applications, student service requests, guidance appointments).
# Gmail requires TWO-STEP VERIFICATION and a GOOGLE APP PASSWORD — never use
# your ordinary Gmail password as MAIL_PASSWORD.
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Uncomment and fill in the values below (and set MAIL_MAILER=smtp above).
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_FROM_ADDRESS=your-gmail@gmail.com
# MAIL_FROM_NAME="ISU OSAS Hub"
#
# Never commit real credentials. Local development can keep MAIL_MAILER=log;
# emails will then be written to storage/logs/laravel.log instead of delivered.

# ── Queues (automatic notification emails) ────────────────────────────────
# Notification emails are queued so slow SMTP delivery never blocks a request.
# With QUEUE_CONNECTION=database you MUST run a worker, otherwise queued emails
# are never sent (in-app notifications still appear):
#   Local:       php artisan queue:work   (or `composer dev`, which already runs it)
#   Failed jobs: php artisan queue:failed / php artisan queue:retry all
#   Reminders:   php artisan schedule:work (sends guidance appointment reminders)
# For a synchronous fallback (no worker) set QUEUE_CONNECTION=sync; note this
# makes requests wait for SMTP.

# ── Academic term (enrollment verification scoping) ───────────────────────
# Update these at the start of each academic year / semester.
ACADEMIC_CURRENT_YEAR=2025-2026
ACADEMIC_CURRENT_SEMESTER=first

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
